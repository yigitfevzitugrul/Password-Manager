{
    "name": "sifreyonetici",
    "private": true,
    "version": "1.1.0",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "concurrently \"npm run vite:dev\" \"npm run electron:dev\"",
        "vite:dev": "vite",
        "electron:dev": "wait-on tcp:5173 && electron .",
        "build": "vite build && electron-builder",
        "preview": "vite preview",
        "test": "node --test \"tests/unit/*.test.mjs\"",
        "test:e2e": "vite build && node tests/run-e2e.cjs"
    },
    "devDependencies": {
        "@noble/ciphers": "^2.4.0",
        "@noble/hashes": "^2.4.0",
        "@vitejs/plugin-react": "^5.1.2",
        "@zxcvbn-ts/core": "^4.2.0",
        "@zxcvbn-ts/language-common": "^4.1.3",
        "@zxcvbn-ts/language-en": "^4.1.1",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "electron": "^44.6.0",
        "electron-builder": "^26.0.12",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "uuid": "^13.0.0",
        "vite": "^7.3.0",
        "wait-on": "^9.0.3"
    },
    "dependencies": {
        "qrcode": "^1.5.4"
    },
    "description": "Orenda Pass - Güvenli ve Şifreli Yerel Kasa",
    "author": "Yigit",
    "build": {
        "appId": "com.yigit.sifreyonetici",
        "productName": "Orenda Pass",
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "!electron/main.js",
            "shared/**/*",
            "!shared/noblePrimitives.js",
            "Image/icon.*",
            "package.json"
        ],
        "win": {
            "icon": "Image/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "${productName}-Setup-${version}.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "shortcutName": "Orenda Pass"
        },
        "publish": null
    },
    "overrides": {
        "shell-quote": "^1.12.0"
    }
}
